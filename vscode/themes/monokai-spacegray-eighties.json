{
    "$schema": "vscode://schemas/color-theme",
    "name": "Monokai Spacegray Eighties",
    "type": "dark",
    "semanticHighlighting": false,
    "colors": {
        "editor.background": "#1C1C1C",
        "editor.foreground": "#F8F8F8",
        "editor.lineHighlightBackground": "#343434",
        "editor.selectionBackground": "#3E4A57",
        "editor.selectionHighlightBackground": "#3E4A5780",
        "editor.findMatchBackground": "#515C6A",
        "editor.findMatchHighlightBackground": "#515C6A40",
        "editor.wordHighlightBackground": "#4C4C4C80",
        "editor.wordHighlightStrongBackground": "#4C4C4CB0",
        "editorCursor.foreground": "#F8F8F8",
        "editorWhitespace.foreground": "#3A3A3A",
        "editorLineNumber.foreground": "#8A8A8A",
        "editorLineNumber.activeForeground": "#F8F8F8",
        "editorIndentGuide.background": "#3A3A3A",
        "editorIndentGuide.activeBackground": "#6A6A6A",
        "editorBracketMatch.background": "#80808080",
        "editorBracketMatch.border": "#808080",
        "sideBar.background": "#1C1C1C",
        "sideBar.foreground": "#F8F8F8",
        "sideBarSectionHeader.background": "#343434",
        "activityBar.background": "#1C1C1C",
        "activityBar.foreground": "#F8F8F8",
        "statusBar.background": "#1C1C1C",
        "statusBar.foreground": "#F8F8F8",
        "tab.activeBackground": "#343434",
        "tab.inactiveBackground": "#1C1C1C",
        "tab.activeForeground": "#F8F8F8",
        "tab.inactiveForeground": "#808080",
        "tab.border": "#1C1C1C",
        "editorGroupHeader.tabsBackground": "#1C1C1C",
        "titleBar.activeBackground": "#1C1C1C",
        "titleBar.activeForeground": "#F8F8F8",
        "titleBar.inactiveBackground": "#1C1C1C",
        "titleBar.inactiveForeground": "#808080",
        "statusBar.noFolderBackground": "#1C1C1C",
        "panel.border": "#343434",
        "editorWidget.background": "#262626",
        "editorWidget.border": "#3C3C3C",
        "input.background": "#262626",
        "input.border": "#3C3C3C",
        "dropdown.background": "#262626",
        "dropdown.border": "#3C3C3C",
        "list.activeSelectionBackground": "#3E4A57",
        "list.inactiveSelectionBackground": "#343434",
        "list.hoverBackground": "#2A2A2A",
        "notebook.selectedCellBackground": "#2A2A2A",
        "positronConsole.errorForeground": "#F92672",
        "focusBorder": "#66D9EF80",
        "button.background": "#66D9EF",
        "button.hoverBackground": "#8EE6F5",
        "button.foreground": "#1C1C1C",
        "activityBar.activeBorder": "#66D9EF",
        "activityBar.activeBackground": "#343434",
        "activityBar.inactiveForeground": "#808080",
        "badge.background": "#66D9EF",
        "badge.foreground": "#1C1C1C",
        "activityBarBadge.background": "#66D9EF",
        "activityBarBadge.foreground": "#1C1C1C",
        "progressBar.background": "#66D9EF",
        "textLink.foreground": "#66D9EF",
        "textLink.activeForeground": "#8EE6F5",
        "statusBar.debuggingBackground": "#FD971F",
        "statusBar.debuggingForeground": "#1C1C1C",
        "terminal.foreground": "#F8F8F8",
        "terminal.background": "#1C1C1C",
        "terminal.ansiBlack": "#3C3C3C",
        "terminal.ansiRed": "#F92672",
        "terminal.ansiGreen": "#A6E22E",
        "terminal.ansiYellow": "#E6DB74",
        "terminal.ansiBlue": "#6699CC",
        "terminal.ansiMagenta": "#AE81FF",
        "terminal.ansiCyan": "#66D9EF",
        "terminal.ansiWhite": "#CFCFCF",
        "terminal.ansiBrightBlack": "#808080",
        "terminal.ansiBrightRed": "#FF5C8F",
        "terminal.ansiBrightGreen": "#BEF05A",
        "terminal.ansiBrightYellow": "#F4EC9C",
        "terminal.ansiBrightBlue": "#8FB8E0",
        "terminal.ansiBrightMagenta": "#C6A6FF",
        "terminal.ansiBrightCyan": "#8EE6F5",
        "terminal.ansiBrightWhite": "#F8F8F8"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#808080"
            }
        },
        {
            "name": "Strings",
            "scope": "string",
            "settings": {
                "foreground": "#E6DB74"
            }
        },
        {
            "name": "Numbers and Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "constant.character",
                "constant.other"
            ],
            "settings": {
                "foreground": "#AE81FF"
            }
        },
        {
            "name": "String Escapes",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": {
                "foreground": "#AE81FF"
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "storage"
            ],
            "settings": {
                "foreground": "#F92672"
            }
        },
        {
            "name": "Operators",
            "scope": [
                "keyword.operator",
                "punctuation.accessor"
            ],
            "settings": {
                "foreground": "#F92672"
            }
        },
        {
            "name": "Storage Types",
            "scope": "storage.type",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#66D9EF"
            }
        },
        {
            "name": "Variables",
            "scope": "variable",
            "settings": {
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Function Parameters",
            "scope": "variable.parameter",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#FD971F"
            }
        },
        {
            "name": "Function Calls - All Cyan",
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#66D9EF"
            }
        },
        {
            "name": "Function Definitions - Green Override",
            "scope": [
                "meta.function entity.name.function",
                "meta.definition.function entity.name.function"
            ],
            "settings": {
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Classes and Types",
            "scope": [
                "support.class",
                "support.type",
                "entity.name.type"
            ],
            "settings": {
                "fontStyle": "italic",
                "foreground": "#66D9EF"
            }
        },
        {
            "name": "Class Definitions",
            "scope": [
                "entity.name.class",
                "entity.name.type.class"
            ],
            "settings": {
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Inherited Classes",
            "scope": "entity.other.inherited-class",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Module Names",
            "scope": [
                "entity.name.namespace",
                "entity.name.module",
                "support.other.module"
            ],
            "settings": {
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Markup Headers",
            "scope": [
                "markup.heading",
                "entity.name.section.markdown",
                "entity.name.section.quarto",
                "heading.1.quarto",
                "heading.2.quarto",
                "heading.3.quarto",
                "heading.4.quarto",
                "heading.5.quarto",
                "heading.6.quarto"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Markup Bold",
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup Italic",
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup Strikethrough",
            "scope": "markup.strikethrough",
            "settings": {
                "fontStyle": "strikethrough"
            }
        },
        {
            "name": "Markup Inline Code",
            "scope": [
                "markup.inline.raw",
                "markup.raw.block"
            ],
            "settings": {
                "foreground": "#FD971F"
            }
        },
        {
            "name": "Markup Links",
            "scope": "markup.underline.link",
            "settings": {
                "fontStyle": "underline",
                "foreground": "#66D9EF"
            }
        },
        {
            "name": "Markup Quotes",
            "scope": "markup.quote",
            "settings": {
                "fontStyle": "italic",
                "foreground": "#808080"
            }
        },
        {
            "name": "Library Constants",
            "scope": "support.constant",
            "settings": {
                "foreground": "#66D9EF"
            }
        },
        {
            "name": "Tag Names",
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#F92672"
            }
        },
        {
            "name": "Tag Attributes",
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Diff Header",
            "scope": "meta.diff",
            "settings": {
                "foreground": "#75715E"
            }
        },
        {
            "name": "Diff Deleted",
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#F92672"
            }
        },
        {
            "name": "Diff Inserted",
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#A6E22E"
            }
        },
        {
            "name": "Diff Changed",
            "scope": "markup.changed",
            "settings": {
                "foreground": "#E6DB74"
            }
        },
        {
            "name": "Invalid/Error",
            "scope": "invalid",
            "settings": {
                "background": "#F92672",
                "foreground": "#F8F8F8"
            }
        },
        {
            "name": "Invalid Deprecated",
            "scope": "invalid.deprecated",
            "settings": {
                "background": "#AE81FF",
                "foreground": "#F8F8F8"
            }
        }
    ]
}
